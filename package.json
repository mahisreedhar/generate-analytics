{
  "name": "generate-analytics",
  "version": "1.0.0",
  "description": "Appwrite Function: compute and store anthropometric analytics from visit_answers events",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "backfill:analytics": "npm run build && node dist/scripts/backfill-analytics.js",
    "export:duplicate-children": "npm run build && node dist/scripts/export-duplicate-children.js",
    "format": "prettier --write ."
  },
  "dependencies": {
    "axios": "^1.7.2",
    "node-appwrite": "^20.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prettier": "^3.2.5",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
